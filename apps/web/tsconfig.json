{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@sentinel/types/wholesale": ["../../packages/types/wholesale.ts"],
      "@sentinel/types": ["../../packages/types/index.ts"],
      "@sentinel/agent/coordination": ["../../packages/agent/coordination.ts"],
      "@sentinel/calle/wholesale": ["../../packages/calle/wholesale.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "../../packages/types/wholesale.ts"
  ],
  "exclude": ["node_modules"]
}
