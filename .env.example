# Copy this to .env and fill in your values.
# NEVER commit .env — it is gitignored.

# CALL-E credentials (get from https://dashboard.heycall-e.com/account/api-keys)
CALLE_API_KEY=iams_live_replace_me
CALLE_BASE_URL=https://api.heycall-e.com
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Used only when ElevenLabs synthesis fails. Requires Python 3.10-3.12 and
# packages/calle/requirements.txt installed in that interpreter.
KOKORO_PYTHON=python
KOKORO_VOICE=af_heart

# Set to "true" during development to use the mock CALL-E driver.
# Must be "false" (or unset) in demo, deployed app, and recording.
CALLE_USE_MOCK=true

# Consented test number for live-call scripts (E.164). Never commit a real number.
CALLE_TEST_PHONE=+910000000000
